#:culture{:id "isr.dish.falafel", :name "Falafel", :country "ISR", :kind :dish, :summary "Deep-fried fritter of ground fava beans or chickpeas that most likely originated in Egypt; the chickpea version is a popular street food adopted into Israeli cuisine and called a national dish of Israel, a designation contested by Palestinians and other Arabs.", :url "https://en.wikipedia.org/wiki/Falafel", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "isr.dish.shakshouka", :name "Shakshouka", :country "ISR", :kind :dish, :summary "Maghrebi dish of eggs poached in a spiced tomato sauce, brought to Israel by Maghrebi Jewish immigrants in the 1950s and now a popular breakfast and evening meal throughout the country.", :url "https://en.wikipedia.org/wiki/Shakshouka", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "isr.dish.sabich", :name "Sabich", :country "ISR", :kind :dish, :summary "Israeli street-food sandwich of fried eggplant, hard-boiled eggs, salad and tahini, created in 1961 in Ramat Gan by Iraqi Jewish immigrant Sabich Tzvi Halabi from ingredients of the Iraqi Jewish Shabbat breakfast.", :url "https://en.wikipedia.org/wiki/Sabich", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "isr.dish.ptitim", :name "Ptitim", :country "ISR", :kind :dish, :summary "Toasted grain-shaped wheat pasta, also called Israeli couscous, created in Israel in 1953 as a rice substitute during the austerity period at prime minister David Ben-Gurion's request.", :url "https://en.wikipedia.org/wiki/Ptitim", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "isr.dish.israeli-salad", :name "Israeli salad", :country "ISR", :kind :dish, :summary "Chopped salad of finely diced tomato, onion, cucumber and peppers, a standard accompaniment to Israeli meals; it traces back to the Turkish çoban salatası and was adopted by Jewish immigrants to the Levant in the late 19th century.", :url "https://en.wikipedia.org/wiki/Israeli_salad", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "isr.product.jaffa-orange", :name "Jaffa orange", :country "ISR", :kind :product, :summary "Orange variety with few seeds and tough skin developed by Arab farmers in mid-19th-century Ottoman Palestine and named after the city of Jaffa from which it was first exported; today cultivated across the region including Israel.", :url "https://en.wikipedia.org/wiki/Jaffa_orange", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "isr.beverage.israeli-wine", :name "Israeli wine", :country "ISR", :kind :beverage, :summary "Wine produced in the Land of Israel since biblical times; the modern industry was founded in the late 19th century by Baron Edmond James de Rothschild through the Carmel Winery.", :url "https://en.wikipedia.org/wiki/Israeli_wine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Independence_Day_(Israel)", :id "isr.festival.yom-haatzmaut", :kind :festival, :name-local "Yom Ha'atzmaut", :country "ISR", :retrieved-at "2026-07-17", :summary "Israel's national day commemorating the Israeli Declaration of Independence of 14 May 1948, observed on the 5th of Iyar with ceremonies, family celebrations and fireworks.", :name "Independence Day", :url-provenance :wikipedia-en}
#:culture{:id "isr.heritage.masada", :name "Masada", :country "ISR", :kind :heritage, :summary "Ancient mountain-top fortress in the Judaean Desert built in the first century BC, used by Jewish rebels in the First Jewish-Roman War; a UNESCO World Heritage Site inscribed in 2001.", :url "https://en.wikipedia.org/wiki/Masada", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
